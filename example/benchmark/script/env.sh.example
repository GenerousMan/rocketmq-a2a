# ========================================
# 项目路径配置
# ========================================
# 获取脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# benchmark根目录（script的父目录）
BENCHMARK_ROOT="$(dirname "$SCRIPT_DIR")"

# 项目根目录（benchmark的祖父级目录）
PROJECT_ROOT="$(dirname "$(dirname "$BENCHMARK_ROOT")")"

# ========================================
# RocketMQ 基础连接配置 (仅RocketMQ协议需要)
# ========================================
# RocketMQ Endpoint (格式: domain:port)
export ROCKETMQ_ENDPOINT=""

# RocketMQ 命名空间
export ROCKETMQ_NAMESPACE=""

# RocketMQ AK/SK
export ROCKETMQ_AK=""
export ROCKETMQ_SK=""

# ========================================
# RocketMQ Topic 配置 (仅RocketMQ协议需要)
# ========================================
# Supervisor <-> Worker Agent 响应通信
export WORK_AGENT_RESPONSE_TOPIC=""
export WORK_AGENT_RESPONSE_GROUP_ID=""

# WeatherAgent 业务Topic
export WEATHER_AGENT_BIZ_TOPIC=""
export WEATHER_AGENT_BIZ_CONSUMER_GROUP=""

# TravelAgent 业务Topic
export TRAVEL_AGENT_BIZ_TOPIC=""
export TRAVEL_AGENT_BIZ_CONSUMER_GROUP=""

# ========================================
# A2A 协议配置 (仅A2A协议需要)
# ========================================
# Agent延迟响应时间（秒），用于模拟LLM调用时间
export A2A_DELAY_SECONDS="2"

# Agent固定响应内容（可选，如果不设置则使用默认内容）
# export A2A_FIXED_RESPONSE=""

# ========================================
# 其他配置
# ========================================
# API Key (如果需要调用真实的LLM)
export API_KEY=""

# 打印配置信息
echo "✅ 环境配置已加载"
echo "   - PROJECT_ROOT: ${PROJECT_ROOT}"
echo "   - BENCHMARK_ROOT: ${BENCHMARK_ROOT}"
echo "   - SCRIPT_DIR: ${SCRIPT_DIR}"
